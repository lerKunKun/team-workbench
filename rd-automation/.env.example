# Run ./scripts/init-env.sh to generate private local secrets.
COMPOSE_PROJECT_NAME=rd-automation
POSTGRES_PASSWORD= # generated locally
APP_DB_PASSWORD= # generated locally
N8N_DB_PASSWORD= # generated locally
N8N_ENCRYPTION_KEY= # generated locally
INTERNAL_API_TOKEN= # generated locally
N8N_HOOK_TOKEN= # generated locally

# Keep n8n behind the SSH tunnel by default. Set the URL and secure cookies before putting it behind HTTPS.
N8N_HOST_PORT=5678
GATEWAY_HOST_PORT=8080
N8N_PUBLIC_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0

# No credentials or real external calls in base mode. Demo performs no real writes.
DEMO_MODE=false
DINGTALK_STREAM_ENABLED=false
DINGTALK_WORKBENCH_DM=false
DINGTALK_CORP_ID=
WORKBENCH_API_URL=
WORKBENCH_BOT_TOKEN=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_CARD_TEMPLATE_ID=
# Comma-separated group openConversationId values. Empty rejects incoming messages/clicks.
DINGTALK_ALLOWED_GROUPS=
# Linear personal API key (not an OAuth bearer token).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Optional: comma-separated LabelName=LinearLabelUUID pairs. No IDs means suggestions only.
LINEAR_LABEL_IDS=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set false if the model provider doesn't implement response_format=json_object.
LLM_JSON_MODE=true

# V1: optional incoming webhooks; routing is to this single approved test group first.
V1_CONVERSATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPOSITORIES=
LINEAR_WEBHOOK_SECRET=
